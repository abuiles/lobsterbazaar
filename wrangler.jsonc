{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lobsterbrew",
  "main": "src/index.ts",
  "preview_urls": true,
  "compatibility_date": "2026-03-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lobsterbazaar",
      "database_id": "93768a85-e0e1-4082-bd39-04a3d8ad87be"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "lobsterbazaar-artifacts"
    }
  ]
}
