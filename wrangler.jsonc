{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Shared placeholder config only.
  // Real instance configs live under deploys/private/lobsterbrew/verticals/*/wrangler.jsonc
  "name": "${LOBSTERBAZAAR_WORKER_NAME}",
  "main": "src/index.ts",
  "preview_urls": true,
  "compatibility_date": "2026-03-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "lobsterbazaar_metrics"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "${LOBSTERBAZAAR_DB_NAME}",
      "database_id": "${LOBSTERBAZAAR_DB_ID}"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "${LOBSTERBAZAAR_ARTIFACTS_BUCKET}"
    }
  ]
}
